# Browser-safe EmailJS identifiers. No passwords, SMTP credentials or private keys.
# Set Yen's fixed recipient address privately in the EmailJS template dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Local previews do not send email by default. Enable only for deliberate live tests.
VITE_EMAIL_SEND_IN_PREVIEW=false
